# Placeholder only. Set privately in a terminal; never add a real key to this file.
CASCADE_PROVIDER=mock
CASCADE_ALLOW_LIVE=0
CASCADE_DB=backend/data/development.sqlite3
CASCADE_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CASCADE_MAX_BODY_BYTES=262144
CASCADE_MAX_JOBS=4
CASCADE_MAX_SESSIONS=1000
# Workspace-specific HTTP endpoint = console "Base URL" + /chat/completions.
# Supported regions: ap-southeast-1 (Singapore), cn-beijing, cn-hongkong, ap-northeast-1 (Tokyo).
# The API key must be created in the same region as the endpoint.
QWEN_ENDPOINT=https://YOUR-WORKSPACE-ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-plus
DASHSCOPE_API_KEY=REPLACE_PRIVATELY
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=700
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_ATTEMPTS=2

# --- Online deployment only (set in the Render dashboard, not here). See docs/DEPLOYMENT.md.
# Leaving these unset keeps the server local-only on 127.0.0.1 with SQLite.
# CASCADE_HOST=0.0.0.0
# CASCADE_ALLOWED_HOSTS=your-service.onrender.com
# CASCADE_ORIGINS=https://html-classic.itch.zone,https://html.itch.zone
# CASCADE_DATABASE_URL=postgresql://cascade_app:REPLACE_PRIVATELY@your-db.xxxx.rds.amazonaws.com:5432/cascade_lab
# CASCADE_ACCESS_CODE=REPLACE_PRIVATELY
# CASCADE_MAX_DAILY_SESSIONS=50
# CASCADE_MAX_DAILY_INTERVENTIONS=300

# Public demo sessions (no access code). Personal/synthetic testing is not research enrollment.
# Defaults keep gameplay records local and make public AI unavailable until policy is configured.
CASCADE_PUBLIC_RECORDS=0
CASCADE_PUBLIC_AI=0
CASCADE_PUBLIC_POLICY_ID=
CASCADE_MAX_MINUTE_SESSIONS=10
CASCADE_MAX_DAILY_AI_ATTEMPTS=300
CASCADE_PUBLIC_SESSION_SECONDS=86400
CASCADE_PUBLIC_ROUND_INTERVAL=120
# CASCADE_ACCESS_CODE still protects the legacy /v1/sessions route; never embed it in a web build.
